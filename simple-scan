#!/usr/bin/env bash
#
#  simple-scan - Escaneo automatico en dos fases con nmap
#  ------------------------------------------------------------------
#  Fase 1  Descubrimiento de puertos abiertos (rapido, no intrusivo)
#  Fase 2  Deteccion de servicios/versiones sobre los puertos abiertos
#
#  Lee una lista de IPs desde un .txt y genera un unico XML combinado.
#  Tres perfiles de intensidad: bajo | medio | agresivo.
#
#  Uso:
#     simple-scan -l ips.txt -o out.xml -p medio
#
set -euo pipefail

VERSION="1.0.0"

# Origen para --update (se puede sobreescribir por entorno)
REPO_SLUG="${SIMPLE_SCAN_REPO:-M4nuTCP/simple-nmap-scan}"
REPO_BRANCH="${SIMPLE_SCAN_BRANCH:-main}"
UPDATE_URL="${SIMPLE_SCAN_URL:-https://raw.githubusercontent.com/${REPO_SLUG}/${REPO_BRANCH}/simple-scan}"

# ===========================================================================
#  Estetica
# ===========================================================================
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    B=$'\033[1m'; DIM=$'\033[2m'; R=$'\033[0m'
    RED=$'\033[38;5;203m'; GRN=$'\033[38;5;114m'; YLW=$'\033[38;5;221m'
    BLU=$'\033[38;5;75m';  CYN=$'\033[38;5;80m';  MAG=$'\033[38;5;176m'
    GREY=$'\033[38;5;245m'
else
    B=""; DIM=""; R=""; RED=""; GRN=""; YLW=""; BLU=""; CYN=""; MAG=""; GREY=""
fi

# Anchura de las lineas decorativas
LINE="────────────────────────────────────────────────────────────"

hr()      { echo -e "${GREY}${LINE}${R}"; }
title()   { echo -e "${B}${BLU}$*${R}"; }
step()    { echo -e "${B}${MAG}$*${R}"; }
info()    { echo -e "  ${CYN}•${R} $*"; }
ok()      { echo -e "  ${GRN}✔${R} $*"; }
warn()    { echo -e "  ${YLW}!${R} $*"; }
err()     { echo -e "${RED}✖${R} $*" >&2; }
field()   { printf "  ${GREY}%-10s${R} %b\n" "$1" "$2"; }

banner() {
    local w=58
    local plain="  simple-scan v${VERSION}   ·   escaneo nmap en dos fases"
    local pad=$(( w - ${#plain} )); (( pad < 0 )) && pad=0
    local bar; bar="$(printf '%.0s─' $(seq 1 "$w"))"
    echo
    echo -e "${BLU}╭${bar}╮${R}"
    echo -e "${BLU}│${R}  ${B}simple-scan${R} ${GREY}v${VERSION}${R}   ${DIM}·${R}   ${DIM}escaneo nmap en dos fases${R}$(printf '%*s' "$pad" '')${BLU}│${R}"
    echo -e "${BLU}╰${bar}╯${R}"
}

# ===========================================================================
#  Autoactualizacion: descarga la ultima version y la reinstala en su sitio
# ===========================================================================
do_update() {
    banner; echo
    title "Actualizar simple-scan"
    hr

    local target tmp newver
    target="$(command -v simple-scan 2>/dev/null || true)"
    [[ -z "$target" ]] && target="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    field "Binario" "${B}${target}${R}"
    field "Origen"  "${GREY}${UPDATE_URL}${R}"
    echo

    tmp="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" RETURN

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$UPDATE_URL" -o "$tmp" || { err "No pude descargar (curl) desde el origen."; return 1; }
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$tmp" "$UPDATE_URL" || { err "No pude descargar (wget) desde el origen."; return 1; }
    else
        err "Necesito ${B}curl${R} o ${B}wget${R} para actualizar."; return 1
    fi

    # Validar que lo descargado es realmente simple-scan
    if ! head -n1 "$tmp" | grep -q '^#!.*bash' || ! grep -q 'simple-scan' "$tmp"; then
        err "La descarga no parece un simple-scan valido. Aborto sin tocar nada."
        return 1
    fi

    newver="$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)"
    if [[ -n "$newver" && "$newver" == "$VERSION" ]]; then
        hr; ok "Ya tienes la ultima version (${B}v${VERSION}${R})."; echo
        return 0
    fi

    chmod +x "$tmp"
    if [[ -w "$target" ]]; then
        install -m 0755 "$tmp" "$target"
    elif command -v sudo >/dev/null 2>&1; then
        warn "Se necesitan privilegios para escribir en ${target}"
        sudo install -m 0755 "$tmp" "$target"
    else
        err "Sin permisos de escritura en ${target} y no hay sudo. Reintenta como root."
        return 1
    fi

    hr
    ok "Actualizado: ${B}v${VERSION}${R} → ${GRN}${B}v${newver:-?}${R}"
    echo
}

# ===========================================================================
#  Perfiles  (flags de AJUSTE que se anaden a los comandos base de nmap)
#  Base fase 1:  nmap -p- --open -sS -vvv -n -Pn <ip> -oG <f>
#  Base fase 2:  nmap -sCV -p<puertos> -vvv -n -Pn <ip> -oX <f>
#
#  Claves de diseno:
#   - El techo real de carga lo pone --max-rate en TODOS los perfiles.
#   - Fase 1 nunca usa -T2: su --scan-delay de 400ms sobre -p- (65535
#     puertos) tardaria horas por host. bajo usa -T3 (se adapta y frena
#     ante perdida) + techo bajo + sin --min-rate (deja que nmap frene).
#   - agresivo se queda en -T4, nunca -T5 (T5 baja retries y da falsos
#     negativos de puertos); va mas rapido pero con techo y retries >= 2.
#   - --randomize-hosts reparte la carga y no concentra en una subred.
# ===========================================================================
declare -A DISC_FLAGS SERV_FLAGS PROFILE_DESC PROFILE_RATE

# bajo: super seguro. Sin --min-rate para que nmap frene ante congestion.
DISC_FLAGS[bajo]="-T3 --max-rate 500 --max-hostgroup 16 --max-retries 5 --host-timeout 45m --randomize-hosts"
SERV_FLAGS[bajo]="-T3 --max-rate 500 --version-intensity 2 --script-timeout 60s --max-retries 5 --host-timeout 30m"
PROFILE_DESC[bajo]="super seguro — no tumba redes fragiles (mas lento)"
PROFILE_RATE[bajo]="<=500 pps"

# medio: sintonia perfecta. Ventana 1000-3000 pps: rapido y sin saturar.
DISC_FLAGS[medio]="-T4 --min-rate 1000 --max-rate 3000 --max-retries 3 --min-hostgroup 128 --host-timeout 30m --randomize-hosts"
SERV_FLAGS[medio]="-T4 --script-timeout 2m --host-timeout 30m"
PROFILE_DESC[medio]="sintonia perfecta velocidad / no saturar (por defecto)"
PROFILE_RATE[medio]="1000-3000 pps"

# agresivo: mas rapido pero acotado. Techo 8000 pps, RTT ajustado, retries>=2.
DISC_FLAGS[agresivo]="-T4 --min-rate 3000 --max-rate 8000 --max-retries 2 --min-hostgroup 256 --max-rtt-timeout 300ms --initial-rtt-timeout 150ms --host-timeout 15m --randomize-hosts --defeat-rst-ratelimit"
SERV_FLAGS[agresivo]="-T4 --max-rate 8000 --version-light --script-timeout 60s --max-retries 2 --host-timeout 15m --defeat-rst-ratelimit"
PROFILE_DESC[agresivo]="mas rapido pero acotado (no a lo loco)"
PROFILE_RATE[agresivo]="3000-8000 pps"

# ===========================================================================
#  Ayuda
# ===========================================================================
usage() {
    banner
    cat <<EOF

${B}USO${R}
  simple-scan -l <ips.txt> -o <salida.xml> [-p <perfil>] [-y]

${B}PARAMETROS${R}
  -l, --list      Fichero .txt con una IP (o rango) por linea.
  -o, --output    Nombre del fichero XML de salida.
  -p, --profile   Perfil de intensidad: bajo | medio | agresivo  (def: medio)
  -y, --yes       No preguntar confirmacion, ejecutar directamente.
      --update    Descargar la ultima version y reinstalarla.
  -h, --help      Esta ayuda.
      --version   Version.

${B}PERFILES${R}
  ${GRN}bajo${R}      ${PROFILE_DESC[bajo]}  ${GREY}[${PROFILE_RATE[bajo]}]${R}
  ${YLW}medio${R}     ${PROFILE_DESC[medio]}  ${GREY}[${PROFILE_RATE[medio]}]${R}
  ${RED}agresivo${R}  ${PROFILE_DESC[agresivo]}  ${GREY}[${PROFILE_RATE[agresivo]}]${R}

${B}EJEMPLO${R}
  simple-scan -l ips.txt -o out.xml -p medio
EOF
    echo
}

# ===========================================================================
#  Parseo de argumentos
# ===========================================================================
IP_LIST=""; OUT_XML=""; PROFILE="medio"; ASSUME_YES=0
POSITIONAL=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -l|--list)    IP_LIST="${2:-}"; shift 2 ;;
        -o|--output)  OUT_XML="${2:-}"; shift 2 ;;
        -p|--profile) PROFILE="${2:-}"; shift 2 ;;
        -y|--yes)     ASSUME_YES=1; shift ;;
        --update)     do_update; exit $? ;;
        -h|--help)    usage; exit 0 ;;
        --version)    echo "simple-scan v${VERSION}"; exit 0 ;;
        -*)           err "Opcion desconocida: $1"; echo "Prueba: simple-scan --help" >&2; exit 1 ;;
        *)            POSITIONAL+=("$1"); shift ;;
    esac
done

[[ -z "$IP_LIST" && ${#POSITIONAL[@]} -ge 1 ]] && IP_LIST="${POSITIONAL[0]}"
[[ -z "$OUT_XML" && ${#POSITIONAL[@]} -ge 2 ]] && OUT_XML="${POSITIONAL[1]}"

# ===========================================================================
#  Validaciones
# ===========================================================================
[[ -z "$IP_LIST" || -z "$OUT_XML" ]] && { err "Faltan parametros (-l y -o son obligatorios)."; echo "Prueba: simple-scan --help" >&2; exit 1; }
[[ ! -f "$IP_LIST" ]] && { err "No existe el fichero de IPs: ${B}${IP_LIST}${R}"; exit 1; }

if [[ -z "${DISC_FLAGS[$PROFILE]:-}" ]]; then
    err "Perfil desconocido: ${B}${PROFILE}${R}"
    echo -e "   Perfiles validos: ${GRN}bajo${R} | ${YLW}medio${R} | ${RED}agresivo${R}" >&2
    exit 1
fi

command -v nmap >/dev/null 2>&1 || { err "nmap no esta instalado. Instala con: ${B}sudo apt install nmap${R}"; exit 1; }

# Extension .xml
[[ "$OUT_XML" != *.xml ]] && OUT_XML="${OUT_XML}.xml"

# Tipo de escaneo de la fase 1: -sS (SYN) necesita root.
# Sin root, nmap -sS NO hace fallback: sale con error. Usamos -sT (connect),
# que si funciona sin privilegios, y avisamos.
ROOT_WARN=""
if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    SCAN_TYPE="-sS"
    SCAN_DESC="SYN scan (-sS)"
else
    SCAN_TYPE="-sT"
    SCAN_DESC="connect scan (-sT)"
    ROOT_WARN="No estas usando ${B}sudo${R}: el SYN scan ${B}-sS${R} necesita privilegios de root y no se incluira. Se usara ${B}-sT${R} (connect scan), que funciona sin sudo pero es mas lento y ruidoso. Para el escaneo optimo: ${B}sudo simple-scan ...${R}"
fi

# Directorio temporal
TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

# Cargar objetivos (ignora vacias y comentarios #)
mapfile -t TARGETS < <(sed 's/#.*//' "$IP_LIST" | awk '{$1=$1};1' | grep -v '^$')
[[ ${#TARGETS[@]} -eq 0 ]] && { err "El fichero ${B}${IP_LIST}${R} no contiene IPs validas."; exit 1; }

# Color del perfil para la UI
case "$PROFILE" in
    bajo)     PCOL="$GRN" ;;
    medio)    PCOL="$YLW" ;;
    agresivo) PCOL="$RED" ;;
esac

# ===========================================================================
#  Vista previa de los comandos + confirmacion
# ===========================================================================
DFLAGS="${DISC_FLAGS[$PROFILE]}"
SFLAGS="${SERV_FLAGS[$PROFILE]}"

# Plantillas mostradas al usuario (con marcadores legibles)
CMD1_PREVIEW="nmap -iL ${B}<lista>${R} -p- --open ${SCAN_TYPE} ${DFLAGS} -vvv -n -Pn -oG <tmp.gnmap>"
CMD2_PREVIEW="nmap -sCV -p${B}<puertos>${R} ${SFLAGS} -vvv -n -Pn ${B}<ips_con_esos_puertos>${R} -oX <tmp.xml>"

banner
echo
title "Resumen del escaneo"
hr
field "Perfil"    "${PCOL}${B}${PROFILE}${R}  ${GREY}${PROFILE_DESC[$PROFILE]}${R}"
field "Tasa"      "${B}${PROFILE_RATE[$PROFILE]}${R}  ${GREY}(techo con --max-rate)${R}"
field "Escaneo"   "${B}${SCAN_DESC}${R}"
field "Objetivos" "${B}${#TARGETS[@]}${R}  ${GREY}(desde ${IP_LIST})${R}"
field "Salida"    "${B}${OUT_XML}${R}"
hr
echo
title "Comandos que se ejecutaran"
hr
echo -e "  ${B}${CYN}1.${R} ${DIM}(descubrimiento — TODAS las IPs en una sola pasada)${R}"
echo -e "     ${GRN}${CMD1_PREVIEW}${R}"
echo
echo -e "  ${B}${CYN}2.${R} ${DIM}(servicios y versiones — un escaneo por grupo de puertos)${R}"
echo -e "     ${GRN}${CMD2_PREVIEW}${R}"
hr
echo

# Aviso prominente si no hay sudo
if [[ -n "$ROOT_WARN" ]]; then
    warn "$ROOT_WARN"
    echo
fi

if [[ "$ASSUME_YES" -ne 1 ]]; then
    printf "  %b¿Ejecutar el escaneo?%b %b[y/N]%b " "$B" "$R" "$GREY" "$R"
    read -r answer || true
    case "${answer,,}" in
        y|yes|s|si) echo ;;
        *) echo; warn "Cancelado."; exit 0 ;;
    esac
fi

# ===========================================================================
#  Ejecucion
#    Fase 1: UN solo nmap sobre toda la lista (nmap paraleliza entre hosts).
#    Fase 2: se agrupan las IPs por conjunto de puertos identico y se lanza
#            un nmap por grupo (varias IPs en un mismo comando).
# ===========================================================================
XML_PARTS=(); START_TS="$(date +%s 2>/dev/null || echo 0)"

TARGET_FILE="$TMP_DIR/targets.lst"
printf '%s\n' "${TARGETS[@]}" > "$TARGET_FILE"
DISC_GNMAP="$TMP_DIR/discovery.gnmap"

# ---- FASE 1: descubrimiento de TODAS las IPs en una pasada ---------------
echo
hr
title "Fase 1 · Descubrimiento de puertos — ${#TARGETS[@]} IPs en una sola pasada"
hr
echo -e "  ${GRN}\$ nmap -iL ${TARGET_FILE} -p- --open ${SCAN_TYPE} ${DFLAGS} -vvv -n -Pn -oG ${DISC_GNMAP}${R}"
echo
nmap -iL "$TARGET_FILE" -p- --open ${SCAN_TYPE} ${DFLAGS} -vvv -n -Pn -oG "$DISC_GNMAP"

# ---- Agrupar IPs por conjunto de puertos abiertos -----------------------
declare -A GROUP_TARGETS
HOSTS_OPEN=0
while IFS= read -r line; do
    ip="$(awk '{print $2}' <<<"$line")"
    ports="$(grep -oE '[0-9]+/open' <<<"$line" | cut -d '/' -f1 | sort -un | paste -sd, -)"
    [[ -z "$ip" || -z "$ports" ]] && continue
    HOSTS_OPEN=$((HOSTS_OPEN + 1))
    GROUP_TARGETS["$ports"]+="${ip} "
done < <(grep -E '^Host: .*Ports:.*open' "$DISC_GNMAP" 2>/dev/null)

echo
if [[ ${#GROUP_TARGETS[@]} -eq 0 ]]; then
    hr
    warn "Ningun objetivo tenia puertos abiertos: no se genera XML."
    exit 0
fi
ok "Hosts con puertos abiertos: ${GRN}${B}${HOSTS_OPEN}${R}  ·  grupos de puertos: ${B}${#GROUP_TARGETS[@]}${R}"

# ---- FASE 2: un escaneo por grupo de puertos ----------------------------
GI=0
for ports in "${!GROUP_TARGETS[@]}"; do
    GI=$((GI + 1))
    targets="${GROUP_TARGETS[$ports]}"; targets="${targets% }"   # quitar espacio final
    n_ips="$(wc -w <<<"$targets")"
    X_SCAN="$TMP_DIR/serv_${GI}.xml"

    echo
    hr
    title "Fase 2 · Grupo ${GI}/${#GROUP_TARGETS[@]}  ·  puertos ${PCOL}${ports}${R}  ·  ${n_ips} IP(s)"
    hr
    info "IPs: ${GREY}${targets}${R}"
    echo -e "  ${GRN}\$ nmap -sCV -p${ports} ${SFLAGS} -vvv -n -Pn ${targets} -oX ${X_SCAN}${R}"
    echo
    nmap -sCV -p"${ports}" ${SFLAGS} -vvv -n -Pn ${targets} -oX "$X_SCAN"

    XML_PARTS+=("$X_SCAN")
done

# ===========================================================================
#  Combinar los XML de la fase 2 en un unico fichero
# ===========================================================================
echo
hr
if [[ ${#XML_PARTS[@]} -eq 0 ]]; then
    warn "Ningun objetivo tenia puertos abiertos: no se genera XML."
    exit 0
fi

FIRST="${XML_PARTS[0]}"; LAST="${XML_PARTS[${#XML_PARTS[@]}-1]}"
{
    # Cabecera hasta el primer <host>
    awk 'BEGIN{p=1} /<host[ >]/{p=0} p{print}' "$FIRST"
    # Todos los bloques <host>...</host>
    for f in "${XML_PARTS[@]}"; do
        awk '/<host[ >]/{c=1} c{print} /<\/host>/{c=0}' "$f"
    done
    # Runstats + cierre del ultimo
    awk '/<runstats>/{p=1} p{print}' "$LAST"
} > "$OUT_XML"

END_TS="$(date +%s 2>/dev/null || echo 0)"
ELAPSED=$(( END_TS - START_TS ))

title "Escaneo completado"
hr
ok "Hosts con puertos abiertos: ${B}${HOSTS_OPEN}${R} de ${#TARGETS[@]}"
ok "XML generado: ${GRN}${B}${OUT_XML}${R}"
[[ "$ELAPSED" -gt 0 ]] && info "Duracion: ${B}${ELAPSED}s${R}"
hr
echo
