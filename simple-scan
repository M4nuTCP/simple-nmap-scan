#!/usr/bin/env bash
#
#  simple-scan - Escaneo automatico en dos fases con nmap
#  ------------------------------------------------------------------
#  Fase 1  Descubrimiento de puertos abiertos (rapido, no intrusivo)
#  Fase 2  Deteccion de servicios/versiones sobre los puertos abiertos
#
#  Lee una lista de IPs desde un .txt y genera un unico XML combinado.
#  Tres perfiles de intensidad: bajo | medio | agresivo.
#
#  Uso:
#     simple-scan -l ips.txt -o out.xml -p medio
#
set -euo pipefail

VERSION="1.1.0"

# Origen para --update (se puede sobreescribir por entorno).
# HEAD = rama por defecto del repo (funciona sea main, master o la que sea).
REPO_SLUG="${SIMPLE_SCAN_REPO:-M4nuTCP/simple-nmap-scan}"
REPO_BRANCH="${SIMPLE_SCAN_BRANCH:-HEAD}"
UPDATE_URL="${SIMPLE_SCAN_URL:-https://raw.githubusercontent.com/${REPO_SLUG}/${REPO_BRANCH}/simple-scan}"

# ===========================================================================
#  Estetica
# ===========================================================================
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    B=$'\033[1m'; DIM=$'\033[2m'; R=$'\033[0m'
    RED=$'\033[38;5;203m'; GRN=$'\033[38;5;114m'; YLW=$'\033[38;5;221m'
    BLU=$'\033[38;5;75m';  CYN=$'\033[38;5;80m';  MAG=$'\033[38;5;176m'
    GREY=$'\033[38;5;245m'
else
    B=""; DIM=""; R=""; RED=""; GRN=""; YLW=""; BLU=""; CYN=""; MAG=""; GREY=""
fi

# Anchura de las lineas decorativas
LINE="────────────────────────────────────────────────────────────"

hr()      { echo -e "${GREY}${LINE}${R}"; }
title()   { echo -e "${B}${BLU}$*${R}"; }
step()    { echo -e "${B}${MAG}$*${R}"; }
info()    { echo -e "  ${CYN}•${R} $*"; }
ok()      { echo -e "  ${GRN}✔${R} $*"; }
warn()    { echo -e "  ${YLW}!${R} $*"; }
err()     { echo -e "${RED}✖${R} $*" >&2; }
field()   { printf "  ${GREY}%-10s${R} %b\n" "$1" "$2"; }

banner() {
    local w=58
    local plain="  simple-scan v${VERSION}   ·   escaneo nmap en dos fases"
    local pad=$(( w - ${#plain} )); (( pad < 0 )) && pad=0
    local bar; bar="$(printf '%.0s─' $(seq 1 "$w"))"
    echo
    echo -e "${BLU}╭${bar}╮${R}"
    echo -e "${BLU}│${R}  ${B}simple-scan${R} ${GREY}v${VERSION}${R}   ${DIM}·${R}   ${DIM}escaneo nmap en dos fases${R}$(printf '%*s' "$pad" '')${BLU}│${R}"
    echo -e "${BLU}╰${bar}╯${R}"
}

# ===========================================================================
#  Autoactualizacion: descarga la ultima version y la reinstala en su sitio
# ===========================================================================
do_update() {
    banner; echo
    title "Actualizar simple-scan"
    hr

    local target tmp newver
    target="$(command -v simple-scan 2>/dev/null || true)"
    [[ -z "$target" ]] && target="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    field "Binario" "${B}${target}${R}"
    field "Origen"  "${GREY}${UPDATE_URL}${R}"
    echo

    tmp="$(mktemp)"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" RETURN

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$UPDATE_URL" -o "$tmp" || { err "No pude descargar (curl) desde el origen."; return 1; }
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$tmp" "$UPDATE_URL" || { err "No pude descargar (wget) desde el origen."; return 1; }
    else
        err "Necesito ${B}curl${R} o ${B}wget${R} para actualizar."; return 1
    fi

    # Validar que lo descargado es realmente simple-scan
    if ! head -n1 "$tmp" | grep -q '^#!.*bash' || ! grep -q 'simple-scan' "$tmp"; then
        err "La descarga no parece un simple-scan valido. Aborto sin tocar nada."
        return 1
    fi

    newver="$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)"
    # Comparar por CONTENIDO (no solo por numero de version): si el fichero
    # descargado es identico al instalado, no hay nada que actualizar.
    if [[ -f "$target" ]] && cmp -s "$tmp" "$target"; then
        hr; ok "Ya tienes la ultima version (${B}v${VERSION}${R}) — sin cambios."; echo
        return 0
    fi

    chmod +x "$tmp"
    if [[ -w "$target" ]]; then
        install -m 0755 "$tmp" "$target"
    elif command -v sudo >/dev/null 2>&1; then
        warn "Se necesitan privilegios para escribir en ${target}"
        sudo install -m 0755 "$tmp" "$target"
    else
        err "Sin permisos de escritura en ${target} y no hay sudo. Reintenta como root."
        return 1
    fi

    hr
    ok "Actualizado: ${B}v${VERSION}${R} → ${GRN}${B}v${newver:-?}${R}"
    echo
}

# ===========================================================================
#  Perfiles  (flags de AJUSTE que se anaden a los comandos base de nmap)
#  Base fase 1:  nmap -p- --open -sS -vvv -n -Pn <ip> -oG <f>
#  Base fase 2:  nmap -sCV -p<puertos> -vvv -n -Pn <ip> -oX <f>
#
#  Claves de diseno:
#   - El techo real de carga lo pone --max-rate en TODOS los perfiles.
#   - Fase 1 nunca usa -T2: su --scan-delay de 400ms sobre -p- (65535
#     puertos) tardaria horas por host. bajo usa -T3 (se adapta y frena
#     ante perdida) + techo bajo + sin --min-rate (deja que nmap frene).
#   - agresivo se queda en -T4, nunca -T5 (T5 baja retries y da falsos
#     negativos de puertos); va mas rapido pero con techo y retries >= 2.
#   - --randomize-hosts reparte la carga y no concentra en una subred.
# ===========================================================================
declare -A DISC_FLAGS SERV_FLAGS PROFILE_DESC PROFILE_RATE
# Orden de la escalera (mas seguro -> mas rapido). Techo --max-rate estrictamente
# creciente: 100 < 500 < 3000 < 5000 < 8000. Reintentos no crecientes: 7>=5>=3>=2>=2.
PROFILE_ORDER=(superbajo bajo medio alto agresivo)

# superbajo: maxima seguridad (OT/ICS/embebidos o redes inestables). Una sonda
# a la vez (--max-parallelism 1). Fase 2 usa -T2 a proposito (solo puertos
# abiertos): maxima cortesia en la etapa mas intrusiva.
DISC_FLAGS[superbajo]="-T3 --max-rate 100 --max-parallelism 1 --max-hostgroup 8 --max-retries 7 --host-timeout 180m --randomize-hosts"
SERV_FLAGS[superbajo]="-T2 --max-rate 100 --max-parallelism 1 --version-intensity 0 --script-timeout 90s --max-retries 7 --host-timeout 90m"
PROFILE_DESC[superbajo]="maxima seguridad — redes fragiles o inestables (muy lento)"
PROFILE_RATE[superbajo]="<=100 pps"

# bajo: super seguro. Sin --min-rate para que nmap frene ante congestion.
DISC_FLAGS[bajo]="-T3 --max-rate 500 --max-hostgroup 16 --max-retries 5 --host-timeout 45m --randomize-hosts"
SERV_FLAGS[bajo]="-T3 --max-rate 500 --version-intensity 2 --script-timeout 60s --max-retries 5 --host-timeout 30m"
PROFILE_DESC[bajo]="super seguro — no tumba redes fragiles (lento)"
PROFILE_RATE[bajo]="<=500 pps"

# medio: sintonia perfecta. Ventana 1000-3000 pps: rapido y sin saturar.
DISC_FLAGS[medio]="-T4 --min-rate 1000 --max-rate 3000 --max-retries 3 --min-hostgroup 128 --host-timeout 30m --randomize-hosts"
SERV_FLAGS[medio]="-T4 --max-rate 3000 --max-retries 3 --script-timeout 2m --host-timeout 30m"
PROFILE_DESC[medio]="sintonia perfecta velocidad / no saturar (por defecto)"
PROFILE_RATE[medio]="1000-3000 pps"

# alto: rapido y preciso para redes limpias. Entre medio y agresivo, sin
# --defeat-rst-ratelimit (mas preciso).
DISC_FLAGS[alto]="-T4 --min-rate 2000 --max-rate 5000 --max-retries 2 --min-hostgroup 192 --max-rtt-timeout 500ms --initial-rtt-timeout 300ms --host-timeout 20m --randomize-hosts"
SERV_FLAGS[alto]="-T4 --max-rate 5000 --version-light --max-retries 2 --script-timeout 90s --host-timeout 20m"
PROFILE_DESC[alto]="rapido y preciso — para redes limpias (LAN sana)"
PROFILE_RATE[alto]="2000-5000 pps"

# agresivo: mas rapido pero acotado. Techo 8000 pps, RTT ajustado, retries>=2.
DISC_FLAGS[agresivo]="-T4 --min-rate 3000 --max-rate 8000 --max-retries 2 --min-hostgroup 256 --max-rtt-timeout 300ms --initial-rtt-timeout 150ms --host-timeout 15m --randomize-hosts --defeat-rst-ratelimit"
SERV_FLAGS[agresivo]="-T4 --max-rate 8000 --version-light --script-timeout 60s --max-retries 2 --host-timeout 15m --defeat-rst-ratelimit"
PROFILE_DESC[agresivo]="lo mas rapido, acotado — solo LAN robusta"
PROFILE_RATE[agresivo]="3000-8000 pps"

# Color por perfil (para la UI)
color_for_profile() {
    case "$1" in
        superbajo) echo "$CYN" ;;  bajo) echo "$GRN" ;;  medio) echo "$YLW" ;;
        alto)      echo "$MAG" ;;  agresivo) echo "$RED" ;;  *) echo "$R" ;;
    esac
}

# ===========================================================================
#  --check : mide la estabilidad de la red y recomienda un perfil
# ===========================================================================

# Reduce una expresion de objetivo de nmap a UNA IP "pingueable".
reduce_to_ip() {
    local t="$1"
    t="${t%%,*}"                                   # primer elemento de una lista con comas
    if [[ "$t" == *.*/* ]]; then                   # CIDR IPv4  -> red +1
        t="${t%%/*}"; [[ "$t" == *.0 ]] && t="${t%.0}.1"
    fi
    [[ "$t" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+-[0-9]+$ ]] && t="${t%%-*}"   # rango a.b.c.d-e -> a.b.c.d
    echo "$t"
}

# Gateway por defecto (primer salto).
default_gateway() {
    ip route show default 2>/dev/null | awk '/^default/{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}' || true
}

# Ping a $1: rellena PING_RECV, PING_LOSS, PING_AVG, PING_MDEV, PING_MIN, PING_MAX.
run_ping() {
    local host="$1" out nums
    PING_RECV=""; PING_LOSS=""; PING_AVG=""; PING_MDEV=""; PING_MIN=""; PING_MAX=""
    out="$(LC_ALL=C timeout 8 ping -n -q -c 10 -i 0.2 -W 1 -w 5 "$host" 2>/dev/null)" || true
    [[ -z "$out" ]] && return 1
    # || true: con pipefail, un grep sin coincidencias (p.ej. sin linea rtt si
    # el host no responde) haria fallar la tuberia y, con set -e, todo el script.
    PING_LOSS="$(grep -oE '[0-9]+(\.[0-9]+)?% packet loss' <<<"$out" | grep -oE '^[0-9]+(\.[0-9]+)?' | head -1 || true)"
    PING_RECV="$(grep -oE '[0-9]+ received' <<<"$out" | grep -oE '^[0-9]+' | head -1 || true)"
    nums="$(grep -oE '[0-9.]+/[0-9.]+/[0-9.]+(/[0-9.]+)?' <<<"$out" | head -1 || true)"
    if [[ -n "$nums" ]]; then
        PING_MIN="$(cut -d/ -f1 <<<"$nums")"
        PING_AVG="$(cut -d/ -f2 <<<"$nums")"
        PING_MAX="$(cut -d/ -f3 <<<"$nums")"
        PING_MDEV="$(cut -d/ -f4 <<<"$nums")"       # vacio en busybox
    fi
    return 0
}

# Recomienda perfil a partir de las metricas. Usa awk para comparar floats.
# Args: loss jitter jitter_known avg_rtt rtt_known is_vpn reachable
recommend_profile() {
    awk -v loss="${1:-0}" -v jit="${2:-0}" -v jok="${3:-0}" -v rtt="${4:-0}" \
        -v rok="${5:-0}" -v vpn="${6:-0}" -v reach="${7:-1}" 'BEGIN{
        if (reach==0 || loss>=10 || (rok && rtt>800))                              {print "superbajo"; exit}
        if (loss>=1 || vpn==1 || (jok && jit>=30) || (rok && rtt>=300))            {print "bajo";      exit}
        if ((loss>0 && loss<1) || (jok && jit>=10 && jit<30) || (rok && rtt>=100 && rtt<300)) {print "medio"; exit}
        if (loss==0 && vpn==0 && jok && jit<10 && rok && rtt<100 && (jit>=1 || rtt>=20))       {print "alto";  exit}
        if (loss==0 && vpn==0 && reach==1 && jok && jit<1 && rok && rtt<20)        {print "agresivo";  exit}
        print "medio"   # incierto -> por defecto seguro
    }'
}

do_check() {
    banner; echo
    title "Comprobacion de estabilidad de la red"
    hr

    # ---- Elegir objetivo de sondeo -------------------------------------
    local probe="" src_desc="" first=""
    if [[ -n "$IP_LIST" && -f "$IP_LIST" ]]; then
        first="$(sed 's/#.*//' "$IP_LIST" | awk '{$1=$1};1' | grep -v '^$' | head -1 || true)"
        [[ -n "$first" ]] && probe="$(reduce_to_ip "$first")"
    fi
    if [[ -n "$probe" ]]; then
        src_desc="primer objetivo de ${IP_LIST}"
    else
        probe="$(default_gateway)"
        src_desc="gateway por defecto (no se dio -l)"
    fi
    if [[ -z "$probe" ]]; then
        err "No pude determinar un objetivo para el sondeo (ni -l ni gateway)."
        return 1
    fi
    field "Sondeo a" "${B}${probe}${R}  ${GREY}(${src_desc})${R}"

    # ---- Deteccion de VPN / tunel --------------------------------------
    local dev="" is_vpn=0
    dev="$(ip route get "$probe" 2>/dev/null | grep -oE 'dev [^ ]+' | awk '{print $2; exit}' || true)"
    if [[ -n "$dev" ]]; then
        if [[ "$dev" =~ ^(tun|tap|wg|ppp|ipsec|vti|xfrm|gre|sit|utun|nordlynx|proton|tailscale|ts|zt) ]]; then
            is_vpn=1
        elif ip -d link show dev "$dev" 2>/dev/null | grep -qiE 'wireguard|vti|xfrm|ipip|ip6tnl|gre|sit|ppp|tun|tap'; then
            is_vpn=1
        fi
        field "Interfaz" "${B}${dev}${R}$( [[ $is_vpn -eq 1 ]] && echo "  ${YLW}(VPN/tunel)${R}" || echo "  ${GREY}(directa)${R}" )"
    fi

    # ---- Medir (si hay ping) -------------------------------------------
    local reachable=1 jok=0 rok=0 note=""
    if ! command -v ping >/dev/null 2>&1; then
        warn "Sin binario ${B}ping${R}: comprobacion limitada (sin perdida/jitter)."
        if ip route get "$probe" >/dev/null 2>&1; then
            note="ruta resuelta, pero no pude medir estabilidad"
        else
            reachable=0; note="ruta no resoluble"
        fi
        hr
        _check_report "$probe" "?" "?" "?" "$is_vpn" "$reachable" "$note"
        return 0
    fi

    run_ping "$probe"
    # Sin respuestas: puede ser filtrado ICMP. Cruzar con el gateway.
    if [[ -z "${PING_RECV:-}" || "${PING_RECV:-0}" -eq 0 ]]; then
        local gw; gw="$(default_gateway)"
        if [[ -n "$gw" && "$gw" != "$probe" ]] && run_ping "$gw" && [[ "${PING_RECV:-0}" -gt 0 ]]; then
            note="el objetivo filtra ICMP; mido estabilidad del gateway ${gw}"
        else
            reachable=0; note="objetivo y gateway sin respuesta: ruta caida o inestable"
        fi
    fi

    local loss="${PING_LOSS:-100}" avg="${PING_AVG:-}" jit=""
    # jitter: mdev si existe y hay >=3 respuestas; si no, (max-min) como proxy
    if [[ "${PING_RECV:-0}" -ge 3 ]]; then
        if [[ -n "${PING_MDEV:-}" ]]; then jit="$PING_MDEV"; jok=1
        elif [[ -n "${PING_MIN:-}" && -n "${PING_MAX:-}" ]]; then
            jit="$(awk -v a="$PING_MAX" -v b="$PING_MIN" 'BEGIN{printf "%.3f", a-b}')"; jok=1
        fi
    fi
    [[ -n "$avg" ]] && rok=1

    hr
    _check_report "$probe" "$loss" "${avg:-?}" "${jit:-?}" "$is_vpn" "$reachable" "$note" \
        "$(recommend_profile "$loss" "${jit:-0}" "$jok" "${avg:-0}" "$rok" "$is_vpn" "$reachable")"
}

# Imprime el informe + recomendacion. Args: probe loss avg jit vpn reach note [rec]
_check_report() {
    local probe="$1" loss="$2" avg="$3" jit="$4" vpn="$5" reach="$6" note="$7" rec="${8:-medio}"
    [[ "$reach" -eq 0 ]] && rec="superbajo"
    local rc; rc="$(color_for_profile "$rec")"

    field "Alcanzable" "$( [[ $reach -eq 1 ]] && echo "${GRN}si${R}" || echo "${RED}no${R}" )"
    [[ "$loss" != "?" ]] && field "Perdida"  "${B}${loss}%${R}"
    [[ "$avg"  != "?" ]] && field "RTT medio" "${B}${avg} ms${R}"
    [[ "$jit"  != "?" ]] && field "Jitter"    "${B}${jit} ms${R}  ${GREY}(mdev)${R}"
    [[ -n "$note" ]] && field "Nota" "${YLW}${note}${R}"
    hr
    echo -e "  ${B}Perfil recomendado:${R}  ${rc}${B}${rec}${R}  ${GREY}[${PROFILE_RATE[$rec]}]${R}"
    echo -e "  ${GREY}${PROFILE_DESC[$rec]}${R}"
    echo
    local ejemplo="simple-scan -l ${IP_LIST:-ips.txt} -o ${OUT_XML:-out.xml} -p ${rec}"
    echo -e "  ${DIM}Para lanzar el escaneo con esa recomendacion:${R}"
    echo -e "  ${GRN}\$ ${ejemplo}${R}"
    hr
    echo
}

# ===========================================================================
#  Ayuda
# ===========================================================================
usage() {
    banner
    cat <<EOF

${B}USO${R}
  simple-scan -l <ips.txt> -o <salida.xml> [-p <perfil>] [-y]
  simple-scan --check -l <ips.txt>            # mide la red y recomienda perfil

${B}PARAMETROS${R}
  -l, --list      Fichero .txt con una IP (o rango) por linea.
  -o, --output    Nombre del fichero XML de salida.
  -p, --profile   Perfil: superbajo | bajo | medio | alto | agresivo  (def: medio)
  -y, --yes       No preguntar confirmacion, ejecutar directamente.
      --check     Comprobar estabilidad de la red y recomendar un perfil.
      --update    Descargar la ultima version y reinstalarla.
  -h, --help      Esta ayuda.
      --version   Version.

${B}PERFILES${R}  ${GREY}(mas seguro/lento  ->  mas rapido)${R}
  ${CYN}superbajo${R}  ${PROFILE_DESC[superbajo]}  ${GREY}[${PROFILE_RATE[superbajo]}]${R}
  ${GRN}bajo${R}       ${PROFILE_DESC[bajo]}  ${GREY}[${PROFILE_RATE[bajo]}]${R}
  ${YLW}medio${R}      ${PROFILE_DESC[medio]}  ${GREY}[${PROFILE_RATE[medio]}]${R}
  ${MAG}alto${R}       ${PROFILE_DESC[alto]}  ${GREY}[${PROFILE_RATE[alto]}]${R}
  ${RED}agresivo${R}   ${PROFILE_DESC[agresivo]}  ${GREY}[${PROFILE_RATE[agresivo]}]${R}

${B}EJEMPLO${R}
  simple-scan --check -l ips.txt              # 1) ver que perfil conviene
  simple-scan -l ips.txt -o out.xml -p medio  # 2) escanear
EOF
    echo
}

# ===========================================================================
#  Parseo de argumentos
# ===========================================================================
IP_LIST=""; OUT_XML=""; PROFILE="medio"; ASSUME_YES=0; DO_CHECK=0
POSITIONAL=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -l|--list)    IP_LIST="${2:-}"; shift 2 ;;
        -o|--output)  OUT_XML="${2:-}"; shift 2 ;;
        -p|--profile) PROFILE="${2:-}"; shift 2 ;;
        -y|--yes)     ASSUME_YES=1; shift ;;
        --check)      DO_CHECK=1; shift ;;
        --update)     do_update; exit $? ;;
        -h|--help)    usage; exit 0 ;;
        --version)    echo "simple-scan v${VERSION}"; exit 0 ;;
        -*)           err "Opcion desconocida: $1"; echo "Prueba: simple-scan --help" >&2; exit 1 ;;
        *)            POSITIONAL+=("$1"); shift ;;
    esac
done

[[ -z "$IP_LIST" && ${#POSITIONAL[@]} -ge 1 ]] && IP_LIST="${POSITIONAL[0]}"
[[ -z "$OUT_XML" && ${#POSITIONAL[@]} -ge 2 ]] && OUT_XML="${POSITIONAL[1]}"

# --check: mide estabilidad y recomienda perfil (no requiere -o)
[[ "$DO_CHECK" -eq 1 ]] && { do_check; exit $?; }

# ===========================================================================
#  Validaciones
# ===========================================================================
[[ -z "$IP_LIST" || -z "$OUT_XML" ]] && { err "Faltan parametros (-l y -o son obligatorios)."; echo "Prueba: simple-scan --help" >&2; exit 1; }
[[ ! -f "$IP_LIST" ]] && { err "No existe el fichero de IPs: ${B}${IP_LIST}${R}"; exit 1; }

if [[ -z "${DISC_FLAGS[$PROFILE]:-}" ]]; then
    err "Perfil desconocido: ${B}${PROFILE}${R}"
    echo -e "   Perfiles validos: ${CYN}superbajo${R} | ${GRN}bajo${R} | ${YLW}medio${R} | ${MAG}alto${R} | ${RED}agresivo${R}" >&2
    exit 1
fi

command -v nmap >/dev/null 2>&1 || { err "nmap no esta instalado. Instala con: ${B}sudo apt install nmap${R}"; exit 1; }

# Extension .xml
[[ "$OUT_XML" != *.xml ]] && OUT_XML="${OUT_XML}.xml"

# Tipo de escaneo de la fase 1: -sS (SYN) necesita privilegios (sockets raw).
# Se puede si somos root O si el binario nmap tiene la capability cap_net_raw.
# Sin ninguna de las dos, nmap -sS NO hace fallback: sale con error. En ese
# caso usamos -sT (connect scan), que funciona sin privilegios, y avisamos.
CAN_SYN=0
if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    CAN_SYN=1
elif command -v getcap >/dev/null 2>&1; then
    NMAP_REAL="$(readlink -f "$(command -v nmap)" 2>/dev/null || command -v nmap)"
    getcap "$NMAP_REAL" 2>/dev/null | grep -qi 'cap_net_raw' && CAN_SYN=1
fi

ROOT_WARN=""
if [[ "$CAN_SYN" -eq 1 ]]; then
    SCAN_TYPE="-sS"
    SCAN_DESC="SYN scan (-sS)"
else
    SCAN_TYPE="-sT"
    SCAN_DESC="connect scan (-sT)"
    ROOT_WARN="Sin privilegios para SYN scan: ${B}-sS${R} necesita root (o nmap con cap_net_raw) y no se incluira. Se usara ${B}-sT${R} (connect scan), que funciona sin sudo pero es mas lento y ruidoso. Para el escaneo optimo: ${B}sudo simple-scan ...${R}"
fi

# Directorio temporal
TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

# Cargar objetivos (ignora vacias y comentarios #)
mapfile -t TARGETS < <(sed 's/#.*//' "$IP_LIST" | awk '{$1=$1};1' | grep -v '^$')
[[ ${#TARGETS[@]} -eq 0 ]] && { err "El fichero ${B}${IP_LIST}${R} no contiene IPs validas."; exit 1; }

# Color del perfil para la UI
PCOL="$(color_for_profile "$PROFILE")"

# ===========================================================================
#  Vista previa de los comandos + confirmacion
# ===========================================================================
DFLAGS="${DISC_FLAGS[$PROFILE]}"
SFLAGS="${SERV_FLAGS[$PROFILE]}"

# Plantillas mostradas al usuario (con marcadores legibles)
CMD1_PREVIEW="nmap -iL ${B}<lista>${R} -p- --open ${SCAN_TYPE} ${DFLAGS} -vvv -n -Pn -oG <tmp.gnmap>"
CMD2_PREVIEW="nmap -sCV -p${B}<puertos>${R} ${SFLAGS} -vvv -n -Pn ${B}<ips_con_esos_puertos>${R} -oX <tmp.xml>"

banner
echo
title "Resumen del escaneo"
hr
field "Perfil"    "${PCOL}${B}${PROFILE}${R}  ${GREY}${PROFILE_DESC[$PROFILE]}${R}"
field "Tasa"      "${B}${PROFILE_RATE[$PROFILE]}${R}  ${GREY}(techo con --max-rate)${R}"
field "Escaneo"   "${B}${SCAN_DESC}${R}"
field "Objetivos" "${B}${#TARGETS[@]}${R}  ${GREY}(desde ${IP_LIST})${R}"
field "Salida"    "${B}${OUT_XML}${R}"
hr
echo
title "Comandos que se ejecutaran"
hr
echo -e "  ${B}${CYN}1.${R} ${DIM}(descubrimiento — TODAS las IPs en una sola pasada)${R}"
echo -e "     ${GRN}${CMD1_PREVIEW}${R}"
echo
echo -e "  ${B}${CYN}2.${R} ${DIM}(servicios y versiones — un escaneo por grupo de puertos)${R}"
echo -e "     ${GRN}${CMD2_PREVIEW}${R}"
hr
echo

# Aviso prominente si no hay sudo
if [[ -n "$ROOT_WARN" ]]; then
    warn "$ROOT_WARN"
    echo
fi

if [[ "$ASSUME_YES" -ne 1 ]]; then
    printf "  %b¿Ejecutar el escaneo?%b %b[y/N]%b " "$B" "$R" "$GREY" "$R"
    read -r answer || true
    case "${answer,,}" in
        y|yes|s|si) echo ;;
        *) echo; warn "Cancelado."; exit 0 ;;
    esac
fi

# ===========================================================================
#  Ejecucion
#    Fase 1: UN solo nmap sobre toda la lista (nmap paraleliza entre hosts).
#    Fase 2: se agrupan las IPs por conjunto de puertos identico y se lanza
#            un nmap por grupo (varias IPs en un mismo comando).
# ===========================================================================
XML_PARTS=(); START_TS="$(date +%s 2>/dev/null || echo 0)"

TARGET_FILE="$TMP_DIR/targets.lst"
printf '%s\n' "${TARGETS[@]}" > "$TARGET_FILE"
DISC_GNMAP="$TMP_DIR/discovery.gnmap"

# ---- FASE 1: descubrimiento de TODAS las IPs en una pasada ---------------
echo
hr
title "Fase 1 · Descubrimiento de puertos — ${#TARGETS[@]} IPs en una sola pasada"
hr
echo -e "  ${GRN}\$ nmap -iL ${TARGET_FILE} -p- --open ${SCAN_TYPE} ${DFLAGS} -vvv -n -Pn -oG ${DISC_GNMAP}${R}"
echo
set +e
nmap -iL "$TARGET_FILE" -p- --open ${SCAN_TYPE} ${DFLAGS} -vvv -n -Pn -oG "$DISC_GNMAP"
NMAP_RC=$?
set -e
if [[ $NMAP_RC -ne 0 ]]; then
    echo
    hr
    err "La fase 1 termino con error (nmap salio con codigo ${NMAP_RC})."
    warn "Mensajes como ${B}'No such device'${R} o ${B}'The interface disappeared'${R} indican que"
    warn "la interfaz de red (a menudo una ${B}VPN${R}) se cayo durante el escaneo:"
    warn "es un problema de ${B}RED${R}, no del script. Revisa la conexion/VPN y reintenta."
    info "Continuo con los resultados ${B}parciales${R} que haya en el descubrimiento..."
fi

# ---- Agrupar IPs por conjunto de puertos abiertos -----------------------
declare -A GROUP_TARGETS
HOSTS_OPEN=0
while IFS= read -r line; do
    ip="$(awk '{print $2}' <<<"$line")"
    ports="$(grep -oE '[0-9]+/open' <<<"$line" | cut -d '/' -f1 | sort -un | paste -sd, -)"
    [[ -z "$ip" || -z "$ports" ]] && continue
    HOSTS_OPEN=$((HOSTS_OPEN + 1))
    GROUP_TARGETS["$ports"]+="${ip} "
done < <(grep -E '^Host: .*Ports:.*open' "$DISC_GNMAP" 2>/dev/null)

echo
if [[ ${#GROUP_TARGETS[@]} -eq 0 ]]; then
    hr
    warn "Ningun objetivo tenia puertos abiertos: no se genera XML."
    exit 0
fi
ok "Hosts con puertos abiertos: ${GRN}${B}${HOSTS_OPEN}${R}  ·  grupos de puertos: ${B}${#GROUP_TARGETS[@]}${R}"

# ---- FASE 2: un escaneo por grupo de puertos ----------------------------
GI=0
for ports in "${!GROUP_TARGETS[@]}"; do
    GI=$((GI + 1))
    targets="${GROUP_TARGETS[$ports]}"; targets="${targets% }"   # quitar espacio final
    n_ips="$(wc -w <<<"$targets")"
    X_SCAN="$TMP_DIR/serv_${GI}.xml"

    echo
    hr
    title "Fase 2 · Grupo ${GI}/${#GROUP_TARGETS[@]}  ·  puertos ${PCOL}${ports}${R}  ·  ${n_ips} IP(s)"
    hr
    info "IPs: ${GREY}${targets}${R}"
    echo -e "  ${GRN}\$ nmap -sCV -p${ports} ${SFLAGS} -vvv -n -Pn ${targets} -oX ${X_SCAN}${R}"
    echo
    set +e
    nmap -sCV -p"${ports}" ${SFLAGS} -vvv -n -Pn ${targets} -oX "$X_SCAN"
    rc=$?
    set -e
    if [[ $rc -ne 0 ]]; then
        warn "El grupo ${GI} fallo (nmap codigo ${rc}); sigo con el resto."
        [[ -s "$X_SCAN" ]] && XML_PARTS+=("$X_SCAN")   # guardar parcial si hay algo
    else
        XML_PARTS+=("$X_SCAN")
    fi
done

# ===========================================================================
#  Combinar los XML de la fase 2 en un unico fichero
# ===========================================================================
echo
hr
if [[ ${#XML_PARTS[@]} -eq 0 ]]; then
    warn "Ningun objetivo tenia puertos abiertos: no se genera XML."
    exit 0
fi

FIRST="${XML_PARTS[0]}"; LAST="${XML_PARTS[${#XML_PARTS[@]}-1]}"
{
    # Cabecera hasta el primer <host>
    awk 'BEGIN{p=1} /<host[ >]/{p=0} p{print}' "$FIRST"
    # Todos los bloques <host>...</host>
    for f in "${XML_PARTS[@]}"; do
        awk '/<host[ >]/{c=1} c{print} /<\/host>/{c=0}' "$f"
    done
    # Runstats + cierre del ultimo
    awk '/<runstats>/{p=1} p{print}' "$LAST"
} > "$OUT_XML"

END_TS="$(date +%s 2>/dev/null || echo 0)"
ELAPSED=$(( END_TS - START_TS ))

title "Escaneo completado"
hr
ok "Hosts con puertos abiertos: ${B}${HOSTS_OPEN}${R} de ${#TARGETS[@]}"
ok "XML generado: ${GRN}${B}${OUT_XML}${R}"
[[ "$ELAPSED" -gt 0 ]] && info "Duracion: ${B}${ELAPSED}s${R}"
hr
echo
